# EditorConfig — consistent formatting across all editors and platforms
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp}]
indent_style = tab
indent_size = 4

[*.cs]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,uplugin,uproject}]
indent_style = tab
indent_size = 4

# Auto-detect text files and normalize line endings
* text=auto

# Source code — always normalize to LF
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.md text eol=lf

# Unreal config
*.ini text eol=lf
*.uplugin text eol=lf
*.uproject text eol=lf

# Binary assets — never normalize
*.uasset binary
*.umap binary
*.png binary
*.jpg binary
*.bmp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
